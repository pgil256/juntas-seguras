# ==========================================================================
# Juntas Seguras — Environment Variables
# --------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
# NEVER commit real secrets. Only this template (with placeholders) is tracked.
# Required vars are validated at startup by lib/validation.ts.
# ==========================================================================

# ------------------------------------------------------------------
# DATABASE (required)
# ------------------------------------------------------------------
# Local Docker:  mongodb://localhost:27017/juntas-app
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/juntas-app

# ------------------------------------------------------------------
# NEXTAUTH (required)
# ------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# Session-signing secret, at least 32 characters. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-32+-char-random-string

# ------------------------------------------------------------------
# APP URL (required in production; HTTPS enforced there)
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# EMAIL — Gmail SMTP (EMAIL_USER / EMAIL_PASSWORD required; EMAIL_FROM required in prod)
# ------------------------------------------------------------------
# EMAIL_PASSWORD must be a Gmail *App Password*, not your account password.
# See SETUP_GUIDE.md → "Gmail SMTP setup".
EMAIL_USER=your-address@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_FROM=your-address@gmail.com

# ------------------------------------------------------------------
# GOOGLE OAUTH (optional — enables "Sign in with Google")
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------
# MICROSOFT AZURE AD OAUTH (optional — enables "Sign in with Microsoft")
# ------------------------------------------------------------------
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# ------------------------------------------------------------------
# TWILIO (optional — SMS-based MFA)
# ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ------------------------------------------------------------------
# STRIPE — Card contributions + payouts (optional; TEST MODE ONLY)
# ------------------------------------------------------------------
# Enables the "Pay with card (Stripe test)" contribution flow and provider-based
# payouts. Entirely optional — the app falls back to manual methods without it.
# TEST-MODE KEYS ONLY: the app refuses to boot if these are set to live keys.
#   • STRIPE_SECRET_KEY must start with sk_test_
#   • NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY must start with pk_test_
#   • STRIPE_WEBHOOK_SECRET must start with whsec_ (from `stripe listen` or the Dashboard)
# Get test keys at https://dashboard.stripe.com/test/apikeys
# Full walkthrough: docs/stripe-test-mode.md
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------
# CRON (optional — protects /api/cron/* reminder endpoints)
# ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ------------------------------------------------------------------
# DEMO ACCOUNT (used by `npm run seed` and the local/demo experience)
# ------------------------------------------------------------------
# When DEMO_ACCOUNT_EMAIL matches a user's email, that account skips the MFA
# step at sign-in (the password is still required) so reviewers can log in
# without an email inbox. Pre-filled to match the seeded demo user so the
# `npm run seed` -> `npm run dev` -> sign-in flow works out of the box.
# Leave it UNSET in a real production deployment.
DEMO_ACCOUNT_EMAIL=demo@juntas-seguras.app
DEMO_ACCOUNT_PASSWORD=DemoPass123!
