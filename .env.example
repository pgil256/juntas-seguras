# ==========================================================================
# Juntas Seguras — Environment Variables
# --------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
# NEVER commit real secrets. Only this template (with placeholders) is tracked.
# Required vars are validated at startup by lib/validation.ts.
# ==========================================================================

# ------------------------------------------------------------------
# DATABASE (required)
# ------------------------------------------------------------------
# Local Docker:  mongodb://localhost:27017/juntas-app
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/juntas-app

# ------------------------------------------------------------------
# NEXTAUTH (required)
# ------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# Session-signing secret, at least 32 characters. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-32+-char-random-string

# ------------------------------------------------------------------
# APP URL (required in production; HTTPS enforced there)
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# EMAIL — Gmail SMTP (EMAIL_USER / EMAIL_PASSWORD required; EMAIL_FROM required in prod)
# ------------------------------------------------------------------
# EMAIL_PASSWORD must be a Gmail *App Password*, not your account password.
# See SETUP_GUIDE.md → "Gmail SMTP setup".
EMAIL_USER=your-address@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_FROM=your-address@gmail.com

# ------------------------------------------------------------------
# GOOGLE OAUTH (optional — enables "Sign in with Google")
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------
# MICROSOFT AZURE AD OAUTH (optional — enables "Sign in with Microsoft")
# ------------------------------------------------------------------
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# ------------------------------------------------------------------
# TWILIO (optional — SMS-based MFA)
# ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ------------------------------------------------------------------
# STRIPE — Identity / KYC (optional; SCAFFOLDED, not yet wired up)
# ------------------------------------------------------------------
# The Stripe Identity integration is a work in progress; the app runs fine
# without these. If you set them, use TEST-MODE keys only (sk_test_… / pk_test_…).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------
# CRON (optional — protects /api/cron/* reminder endpoints)
# ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ------------------------------------------------------------------
# DEMO ACCOUNT (optional — used by `npm run seed` and the demo deployment)
# ------------------------------------------------------------------
# If DEMO_ACCOUNT_EMAIL is set, the account with that exact email skips the MFA
# step at sign-in so reviewers can log in without an email inbox. The password
# is still required. Set this ONLY in the public demo deployment, NEVER in a
# real production app. DEMO_ACCOUNT_PASSWORD is used by the seed script.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=
