# next-auth v4 declares a peerOptional dependency on nodemailer@^7, but this
# project uses nodemailer@^8 (only for its own Gmail SMTP, not next-auth's email
# provider). The version gap is benign, so we accept it here — this keeps
# `npm install` / `npm ci` working for contributors, CI, and Vercel.
legacy-peer-deps=true
